# عنوان الباك إند — نفس الباك إند الذي يخدم الفرع والمركزي، عبر مسارات
# /api/platform/* وحدها. بدونه يفترض التطبيق باك إند محليًّا على 3001.
VITE_API_URL=http://localhost:3001/api

